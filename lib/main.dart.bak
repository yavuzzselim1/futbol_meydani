        // Centered Text and Premium Glassmorphism Button
        Positioned.fill(
          child: HeroContentAnimator(onPlay: onPlay),
        ),
      ]),
    );
  }
}

class ArenaPainter extends CustomPainter {
  @override
  void paint(Canvas canvas, Size size) {
    // 1. Stadium Lights / Floodlight Rays
    final lightRay = Paint()
      ..shader = const LinearGradient(
        begin: Alignment.topCenter,
        end: Alignment.bottomCenter,
        colors: [Color(0x3522E565), Color(0x00000000)],
      ).createShader(Rect.fromLTWH(0, 0, size.width, size.height));

    final rayPath = Path()
      ..moveTo(size.width * 0.1, 0)
      ..lineTo(size.width * 0.45, size.height)
      ..lineTo(size.width * 0.05, size.height)
      ..close();
    canvas.drawPath(rayPath, lightRay);

    final rayPath2 = Path()
      ..moveTo(size.width * 0.9, 0)
      ..lineTo(size.width * 0.55, size.height)
      ..lineTo(size.width * 0.95, size.height)
      ..close();
    canvas.drawPath(rayPath2, lightRay);

    // 2. Perspective 3D Pitch Base
    final pitchTop = size.height * 0.18;
    final pitchTopLeft = size.width * 0.12;
    final pitchTopRight = size.width * 0.88;
    
    // Adjusted so the lines reach the bottom edge without getting heavily cut off by the sides
    final pitchBottomLeft = -size.width * 0.15;
    final pitchBottomRight = size.width * 1.15;

    final pitchPath = Path()
      ..moveTo(pitchTopLeft, pitchTop)
      ..lineTo(pitchTopRight, pitchTop)
      ..lineTo(pitchBottomRight, size.height)
      ..lineTo(pitchBottomLeft, size.height)
      ..close();

    // 3. Alternating 3D Perspective Grass Stripes
    const stripeCount = 6;
    for (int i = 0; i < stripeCount; i++) {
      final t1 = i / stripeCount;
      final t2 = (i + 1) / stripeCount;

      final y1 = pitchTop + (size.height - pitchTop) * t1;
      final y2 = pitchTop + (size.height - pitchTop) * t2;

      final xLeft1 = pitchTopLeft + (pitchBottomLeft - pitchTopLeft) * t1;
      final xRight1 = pitchTopRight + (pitchBottomRight - pitchTopRight) * t1;

      final xLeft2 = pitchTopLeft + (pitchBottomLeft - pitchTopLeft) * t2;
      final xRight2 = pitchTopRight + (pitchBottomRight - pitchTopRight) * t2;

      final stripePath = Path()
        ..moveTo(xLeft1, y1)

        ..lineTo(xRight1, y1)
        ..lineTo(xRight2, y2)
        ..lineTo(xLeft2, y2)
        ..close();

      final isEven = i % 2 == 0;
      final stripePaint = Paint()
        ..color = isEven ? const Color(0xFF135C3E) : const Color(0xFF0F4A32);
      canvas.drawPath(stripePath, stripePaint);
    }

    // 4. White Field Markings
    final linePaint = Paint()
      ..color = const Color(0x55FFFFFF)
      ..style = PaintingStyle.stroke
      ..strokeWidth = 1.8;

    // Pitch Outer Line
    canvas.drawPath(pitchPath, linePaint);

    // Halfway Line
    final midY = pitchTop + (size.height - pitchTop) * 0.42;
    canvas.drawLine(
      Offset(pitchTopLeft + (pitchBottomLeft - pitchTopLeft) * 0.42, midY),
      Offset(pitchTopRight + (pitchBottomRight - pitchTopRight) * 0.42, midY),
      linePaint,
    );

    // Center Circle (Perspective Oval)
    canvas.drawOval(
      Rect.fromCenter(
        center: Offset(size.width * 0.5, midY),
        width: size.width * 0.60,
        height: size.height * 0.18,
      ),
      linePaint,
    );

    // Goal Box at Horizon
    final goalBoxPath = Path()
      ..moveTo(size.width * 0.32, pitchTop)
      ..lineTo(size.width * 0.68, pitchTop)
      ..lineTo(size.width * 0.72, pitchTop + 45)
      ..lineTo(size.width * 0.28, pitchTop + 45)
      ..close();
    canvas.drawPath(goalBoxPath, linePaint);

    // Goal Frame Art
    final goalFrame = Paint()
      ..color = const Color(0xAAFFFFFF)
      ..style = PaintingStyle.stroke
      ..strokeWidth = 2.5;
    canvas.drawRect(
      Rect.fromLTWH(size.width * 0.38, pitchTop - 18, size.width * 0.24, 18),
      goalFrame,
    );

    // Dark Overlay Gradient at Bottom for text readability
    final bottomGradient = Paint()
      ..shader = const LinearGradient(
        begin: Alignment.topCenter,
        end: Alignment.bottomCenter,
        colors: [Colors.transparent, Color(0xF504140D)],
        stops: [0.35, 1.0],
      ).createShader(Rect.fromLTWH(0, 0, size.width, size.height));
    canvas.drawRect(Rect.fromLTWH(0, 0, size.width, size.height), bottomGradient);
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}

