        }, icon: const Icon(Icons.description_outlined), label: const Text('Raporu Görüntüle / Kopyala')),
        TextButton.icon(onPressed: () async { await diagnostics.clear(); if (context.mounted) ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('Bu cihazdaki tanılama kayıtları temizlendi.'))); }, icon: const Icon(Icons.delete_outline_rounded), label: const Text('Cihaz Kayıtlarını Temizle')),
