class PitchPainter extends CustomPainter {
  @override
  void paint(Canvas canvas, Size size) {
    final beam = Paint()..shader = const LinearGradient(begin: Alignment.topCenter, end: Alignment.bottomCenter, colors: [Color(0x33FFFFFF), Color(0x00FFFFFF)]).createShader(Rect.fromLTWH(0, 0, size.width, size.height));
    canvas.drawPath(Path()..moveTo(size.width * .25, 0)..lineTo(size.width * .42, size.height)..lineTo(size.width * .20, size.height)..close(), beam);
    canvas.drawPath(Path()..moveTo(size.width * .75, 0)..lineTo(size.width * .58, size.height)..lineTo(size.width * .80, size.height)..close(), beam);
    final line = Paint()..color = const Color(0x2871F39A)..style = PaintingStyle.stroke..strokeWidth = 1;
    final field = Path()..moveTo(size.width * .15, size.height)..lineTo(size.width * .33, size.height * .5)..lineTo(size.width * .67, size.height * .5)..lineTo(size.width * .85, size.height)..close();
    canvas.drawPath(field, Paint()..color = const Color(0x221D8A55));
    canvas.drawPath(field, line);
    canvas.drawLine(Offset(size.width / 2, size.height * .5), Offset(size.width / 2, size.height), line);
    canvas.drawOval(Rect.fromCenter(center: Offset(size.width / 2, size.height * .72), width: size.width * .22, height: size.height * .13), line);
    // Goal boxes
    canvas.drawRect(Rect.fromLTWH(size.width * .38, size.height * .5, size.width * .24, size.height * .1), line);
  }
  @override bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}
