}

class StadiumHero extends StatelessWidget {
  const StadiumHero({super.key});
  @override
  Widget build(BuildContext context) => Container(
    height: 10,
    decoration: BoxDecoration(
      gradient: const LinearGradient(
        begin: Alignment.topLeft,
        end: Alignment.bottomRight,
        colors: [Color(0xFF0E3328), Color(0xFF061510)],
      ),
      borderRadius: BorderRadius.circular(28),
      border: Border.all(color: const Color(0x4471F39A), width: 1.2),
      boxShadow: const [BoxShadow(color: Color(0x551D8A55), blurRadius: 48, spreadRadius: -4, offset: Offset(0, 20))],
    ),
    child: Stack(children: [
      // Field background art
      Positioned.fill(child: ClipRRect(borderRadius: BorderRadius.circular(28), child: CustomPaint(painter: PitchPainter()))),
      // Glowing top-right accent
      Positioned(
        top: -30, right: -30,
        child: Container(
          width: 180, height: 180,
          decoration: const BoxDecoration(
            shape: BoxShape.circle,
            gradient: RadialGradient(
              colors: [Color(0x3071F39A), Color(0x00000000)],
            ),
          ),
        ),
      ),
